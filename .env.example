# Copy to .env.local for local dev (npm run dev). Backend must listen on :8000 (see no-broker-backend).
# Vite proxies /api → http://127.0.0.1:8000 when using relative URLs.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production (same-origin behind nginx) — see .env.production.example
# VITE_API_BASE_URL=/api/v1
