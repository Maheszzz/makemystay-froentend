# Copy to .env.local for local dev (npm run dev).
# Backend: makemystay-backend on :8000 — copy RAZORPAY_KEY_ID → NEXT_PUBLIC_RAZORPAY_KEY_ID.
# Next.js rewrites /api/* → http://127.0.0.1:8000/api/* (use relative base below).
NEXT_PUBLIC_API_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1

# Production (same-origin behind nginx) — see .env.production.example
# VITE_API_BASE_URL=/api/v1

# WhatsApp click-to-chat (digits only, with country code). Used on property cards.
# VITE_WHATSAPP_PHONE=918150099911

# Next.js (npm run dev / next build) — client code reads NEXT_PUBLIC_* (mirror VITE_* in .env.local).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# NEXT_PUBLIC_WHATSAPP_PHONE=918150099911

# Prerender.io — set in Netlify / Cloudflare Pages dashboard (NOT VITE_* — server/edge only).
# Used by netlify/edge-functions/prerender.ts and functions/_middleware.js
# PRERENDER_TOKEN=
