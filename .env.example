# Copy to .env for local development:
#   cp .env.example .env
#
# Never commit .env or put private API secrets in NEXT_PUBLIC_* / VITE_* variables.
# Next.js rewrites /api/v1/* -> http://127.0.0.1:8000/api/v1/* (see next.config.ts).
# Vite proxies /api/* -> http://127.0.0.1:8000/api/* (see vite.config.ts).

# --- Public Client Variables (inlined at build time) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1

# Razorpay publishable Key ID (must match backend RAZORPAY_KEY_ID; Key Secret stays on backend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Optional: WhatsApp click-to-chat phone number (digits only, with country code)
# NEXT_PUBLIC_WHATSAPP_PHONE=918150099911
# VITE_WHATSAPP_PHONE=918150099911

# --- Server-Only Runtime Variables (Next.js SSR / API routes) ---
# Must match backend FRONTEND_REVALIDATE_SECRET for POST /api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Optional: override backend base URL for SSR when not using default localhost:8000 / SITE_URL
# SERVER_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional: Bing Webmaster Tools verification user code (if public/BingSiteAuth.xml is absent)
# BING_SITE_AUTH_USER=

# --- Deployment Scripts Only (put in gitignored .deploy.env, never in .env) ---
# DEPLOY_HOST=
# DEPLOY_USER=ubuntu
# DEPLOY_PATH=/var/www/react-app
# PEM_KEY=$HOME/.ssh/your-key.pem
